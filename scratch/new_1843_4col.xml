<t t-name="wtk.report_custom_quote_client_so">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="so">
            <t t-set="doc" t-value="so.x_custom_quote_wizard_id"/>
            <t t-if="doc">
                <t t-set="wiz_cur" t-value="so.currency_id if so.currency_id else env['res.currency'].search([('name','=','USD')], limit=1)"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: DejaVu Sans, Helvetica, Arial, sans-serif; color:#1a1a1a; font-size:11px; line-height:1.45;">
                        <table style="width:100%; border-collapse:collapse; margin-bottom:18px; border:none;">
                            <tr>
                                <td style="padding:10px 12px; vertical-align:top; background:#fafafa; border:none;">
                                    <table style="width:100%; font-size:10px; border-collapse:collapse;">
                                        <tr>
                                            <td style="color:#6b7280; padding:4px 0; width:150px; border:1px solid #e5e7eb;">Service Name</td>
                                            <td style="font-weight:bold; color:#20603D; padding:4px 0; border:1px solid #e5e7eb;">
                                                <span t-if="doc.x_quote_name" t-field="doc.x_quote_name"/>
                                                <span t-else="">—</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color:#6b7280; padding:4px 0; border:1px solid #e5e7eb;">Service Type</td>
                                            <td style="font-weight:bold; padding:4px 0; border:1px solid #e5e7eb;">
                                                <span t-if="doc.x_service_type == 'private'">Private</span>
                                                <span t-elif="doc.x_service_type == 'group'">Group</span>
                                                <span t-else="">—</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="color:#6b7280; padding:4px 0; border:1px solid #e5e7eb;">Number of Passengers (PAX)</td>
                                            <td style="font-weight:bold; padding:4px 0; border:1px solid #e5e7eb;"><span t-field="doc.x_passenger_qty"/></td>
                                        </tr>
                                        
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <div style="margin-bottom:8px;">
                            <span style="display:inline-block; font-size:12px; font-weight:bold; color:#20603D; border-bottom:2px solid #20603D; padding-bottom:2px;">Itinerary</span>
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:10px; border:1px solid #cbd5e1;">
                            <thead>
                                <tr style="background:#20603D; color:#ffffff;">
                                    <th style="text-align:center; width:80px; padding:8px 6px; font-weight:bold;">Date</th>
                                    <th style="text-align:left; width:170px; padding:8px 6px; font-weight:bold;">Tours / Services</th>
                                    <th style="text-align:left; padding:8px 6px; font-weight:bold;">Included Services</th>
                                    <th style="text-align:left; width:170px; padding:8px 6px; font-weight:bold;">Services Not Included</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="doc.x_line_ids">
                                    <t t-foreach="doc.x_line_ids" t-as="line">
                                        <tr>
                                            <td style="text-align:center; padding:7px 6px; border:1px solid #e5e7eb; vertical-align:top;">
                                                <span t-field="line.x_service_date"/>
                                            </td>
                                            <td style="padding:7px 6px; border:1px solid #e5e7eb; vertical-align:top;">
                                                <span t-if="line.x_product_id" t-field="line.x_product_id.display_name"/>
                                                <span t-else="">—</span>
                                            </td>
                                            <td style="padding:7px 6px; border:1px solid #e5e7eb; vertical-align:top;">
                                                <t t-if="line.x_service_line_ids">
                                                    <t t-foreach="line.x_service_line_ids" t-as="svc">
                                                        <t t-if="svc.x_template_id and svc.x_template_id.x_raw_name">
                                                            <div t-out="svc.x_template_id.x_raw_name"/>
                                                        </t>
                                                        <t t-else="">
                                                            <div t-out="svc.x_name or ''"/>
                                                        </t>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:#9ca3af; font-style:italic;">No included services</span>
                                                </t>
                                            </td>
                                            <td style="padding:7px 6px; border:1px solid #e5e7eb; vertical-align:top;">
                                                <t t-if="line.x_not_included_service_line_ids">
                                                    <t t-foreach="line.x_not_included_service_line_ids" t-as="n_svc">
                                                        <div t-out="n_svc.x_name"/>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:#9ca3af; font-style:italic;">—</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="4" style="padding:14px; text-align:center; color:#6b7280; border:1px solid #e5e7eb;">
                                            No products added to this custom quotation.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div style="text-align:right; margin-top:10px; margin-bottom:8px; padding:8px 0;">
                        <span style="font-size:11px; color:#374151;">Final Price:</span>
                        <t t-set="_fp" t-value="doc.x_final_price or 0.0"/>
                        <t t-set="_rounded_fp" t-value="int(_fp) + (1 if ((_fp - int(_fp)) &gt; 0.0001) else 0)"/>
                        <span style="font-size:14px; font-weight:bold; color:#20603D; margin-left:10px;">
                            <span t-out="wiz_cur.name if wiz_cur else 'USD'"/> <t t-out="'{:,.2f}'.format(_rounded_fp)"/>
                        </span>
                    </div>
                        <t t-if="doc.x_not_included_services">
                            <div style="margin-top:20px; margin-bottom:12px; page-break-inside: avoid;">
                                <span style="display:inline-block; font-size:12px; font-weight:bold; color:#E5B745; border-bottom:2px solid #E5B745; padding-bottom:2px;">Observations</span>
                            </div>
                            <div style="font-size:10px; color:#4b5563; line-height:1.45; padding-left:8px; border-left:2px solid #E5B745; page-break-inside: avoid;">
                                <t t-out="doc.x_not_included_services"/>
                            </div>
                        </t>
                        <p style="margin-top:22px; padding-top:12px; border-top:1px solid #e5e7eb; color:#6b7280; font-size:9px; text-align:center;">
                            Informative document generated from Custom Quotation · Wayki Trek · Does not constitute a tax receipt.
                        </p>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="page">
                    <p>No custom quotation found associated with this quotation/order.</p>
                </div>
            </t>
        </t>
    </t>
</t>