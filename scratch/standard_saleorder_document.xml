<t t-name="sale.report_saleorder_document">
    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
    <t t-set="_lang" t-value="doc.partner_id.lang or 'en_US'"/>
    
    <t t-set="_is_es" t-value="_lang and _lang.startswith('es')"/>
    <t t-set="_is_pt" t-value="_lang == 'pt_BR'"/>
    <t t-set="_is_de" t-value="_lang == 'de_DE'"/>
    
    <t t-set="_client_label" t-value="'Cliente' if _is_es else ('Cliente' if _is_pt else ('Kunde' if _is_de else 'Client'))"/>
    <t t-set="_svc_date_label" t-value="'Fecha de Servicio' if _is_es else ('Data do Serviço' if _is_pt else ('Servicedatum' if _is_de else 'Service Date'))"/>
    <t t-set="_ref_label" t-value="'Su Referencia' if _is_es else ('Sua Referência' if _is_pt else ('Ihre Referenz' if _is_de else 'Your Reference'))"/>
    <t t-set="_delivery_label" t-value="'Fecha de Entrega' if _is_es else ('Data de Entrega' if _is_pt else ('Lieferdatum' if _is_de else 'Delivery Date'))"/>
    <t t-set="_contact_label" t-value="'Contacto' if _is_es else ('Contato' if _is_pt else ('Kontakt' if _is_de else 'Contact'))"/>
    <t t-set="_issued_label" t-value="'Fecha de Emisión' if _is_es else ('Data de Emissão' if _is_pt else ('Ausstellungsdatum' if _is_de else 'Issued Date'))"/>
    
    <t t-set="_proforma_label" t-value="'Factura Proforma nº ' if _is_es else ('Fatura Pro Forma nº ' if _is_pt else ('Pro-Forma-Rechnung Nr. ' if _is_de else 'Pro Forma Invoice # '))"/>
    <t t-set="_quotation_label" t-value="'Cotización nº ' if _is_es else ('Orçamento nº ' if _is_pt else ('Angebot Nr. ' if _is_de else 'Quotation # '))"/>
    <t t-set="_order_label" t-value="'Pedido nº ' if _is_es else ('Pedido nº ' if _is_pt else ('Auftrag Nr. ' if _is_de else 'Order # '))"/>
    
    <t t-set="_desc_label" t-value="'Descripción' if _is_es else ('Descrição' if _is_pt else ('Beschreibung' if _is_de else 'Description'))"/>
    <t t-set="_qty_label" t-value="'Cantidad PAX' if _is_es else ('Quantidade PAX' if _is_pt else ('Menge PAX' if _is_de else 'Quantity PAX'))"/>
    <t t-set="_priceunit_label" t-value="'Precio Unitario' if _is_es else ('Preço Unitário' if _is_pt else ('Einzelpreis' if _is_de else 'Unit Price'))"/>
    <t t-set="_discount_label" t-value="'Desc.%' if _is_es else ('Desc.%' if _is_pt else ('Rabatt %' if _is_de else 'Disc.%'))"/>
    <t t-set="_taxes_label" t-value="'Impuestos' if _is_es else ('Impostos' if _is_pt else ('Steuern' if _is_de else 'Taxes'))"/>
    <t t-set="_amount_label" t-value="'Importe' if _is_es else ('Valor' if _is_pt else ('Betrag' if _is_de else 'Amount'))"/>
    
    <t t-set="_inv_ship_label" t-value="'Dirección de Facturación y Envío' if _is_es else ('Endereço de Faturamento e Envio' if _is_pt else ('Rechnungs- und Lieferadresse' if _is_de else 'Invoicing and Shipping Address'))"/>
    <t t-set="_inv_label" t-value="'Dirección de Facturación' if _is_es else ('Endereço de Faturamento' if _is_pt else ('Rechnungsadresse' if _is_de else 'Invoicing Address'))"/>
    <t t-set="_ship_label" t-value="'Dirección de Envío' if _is_es else ('Endereço de Envio' if _is_pt else ('Lieferadresse' if _is_de else 'Shipping Address'))"/>
    
    <t t-set="_signature_label" t-value="'Firma' if _is_es else ('Assinatura' if _is_pt else ('Unterschrift' if _is_de else 'Signature'))"/>
    <t t-set="_fiscal_remark_label" t-value="'Nota de posición fiscal:' if _is_es else ('Observação de Posição Fiscal:' if _is_pt else ('Bemerkung zur steuerlichen Lage:' if _is_de else 'Fiscal Position Remark:'))"/>
    <t t-set="_connect_label" t-value="'Conecte su software' if _is_es else ('Conecte seu software' if _is_pt else ('Verbinden Sie Ihre Software' if _is_de else 'Connect your software'))"/>
    <t t-set="_with_label" t-value="'con' if _is_es else ('com' if _is_pt else ('mit' if _is_de else 'with'))"/>
    <t t-set="_auto_quotes_label" t-value="'para crear cotizaciones automáticamente.' if _is_es else ('para criar orçamentos automaticamente.' if _is_pt else ('um Angebote automatisch zu erstellen.' if _is_de else 'to create quotes automatically.'))"/>
    <t t-set="_itinerary_title" t-value="'Detalles del Servicio e Itinerario' if _is_es else ('Detalhes do Serviço e Itinerário' if _is_pt else ('Servicedetails &amp; Reiseverlauf' if _is_de else 'Service Details &amp; Itinerary'))"/>
    <t t-set="_package_name_label" t-value="'Paquete' if _is_es else ('Pacote' if _is_pt else ('Paket' if _is_de else 'Package'))"/>

    <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
    
    <t t-set="layout_document_title">
        <span t-if="is_proforma"><t t-out="_proforma_label"/></span>
        <span t-elif="doc.state in ['draft','sent']"><t t-out="_quotation_label"/></span>
        <span t-else=""><t t-out="_order_label"/></span>
        <span t-field="doc.name">SO0000</span>
    </t>

    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                          and doc.partner_invoice_id != doc.partner_id                          or doc.partner_shipping_id != doc.partner_invoice_id">
        <t t-set="information_block">
            <strong>
                <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                    <t t-out="_inv_ship_label"/>
                </t>
                <t t-else="">
                    <t t-out="_inv_label"/>
                </t>
            </strong>
            <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
            <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                <strong class="d-block mt-3"><t t-out="_ship_label"/></strong>
                <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
            </t>
        </t>
    </t>
    <t t-call="web.external_layout" address="False" layout_document_title="layout_document_title" information_block="information_block" forced_vat="doc.fiscal_position_id.foreign_vat"> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <div class="page">
            <div class="oe_structure"/>

            <!-- Package name summary (shown only when filled) -->
            <t t-if="doc.x_package_name">
                <div id="product_variant_summary" style="margin-bottom: 20px; padding: 12px 18px; background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-left: 5px solid #20603D; border-radius: 0 6px 6px 0; box-shadow: 0 1px 4px rgba(32,96,61,0.08);">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="display: inline-block; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #E5B745; background-color: #20603D; padding: 3px 10px; border-radius: 3px; white-space: nowrap; flex-shrink: 0;">
                            <t t-out="_package_name_label"/>
                        </span>
                        <span style="font-size: 15px; font-weight: 800; color: #20603D; letter-spacing: -0.01em; line-height: 1.2;" t-field="doc.x_package_name"/>
                    </div>
                </div>
            </t>



            <div class="row mb-4" id="informations">
                <div class="col" name="informations_partner">
                    <strong t-attf-style="color: #{doc.company_id.secondary_color or '#E5B745'} !important;"><t t-out="_client_label"/></strong>
                    <div>
                        <span t-field="doc.partner_id.name"/>
                    </div>
                    <t t-if="doc.partner_id.phone">
                        <div style="font-size: 10px; color: #6b7280; margin-top: 2px;">
                            <span t-field="doc.partner_id.phone"/>
                        </div>
                    </t>
                </div>
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong><t t-out="_ref_label"/></strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma"><t t-out="_issued_label"/></strong>
                    <strong t-else=""><t t-out="_svc_date_label"/></strong>
                    <div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</div>
                </div>

                <div t-if="doc.incoterm" class="col">
                    <strong>Incoterm</strong>
                    <div t-if="doc.incoterm_location">
                        <span t-field="doc.incoterm.code"/> <br/>
                        <span t-field="doc.incoterm_location"/>
                    </div>
                    <div t-else="" t-field="doc.incoterm.code"/>
                </div>
                <div t-if="doc.commitment_date" class="col" name="delivery_date">
                    <strong><t t-out="_delivery_label"/></strong>
                    <div t-field="doc.commitment_date" t-options="{'widget': 'date'}">
                        2023-12-31
                    </div>
                </div>
                <div t-if="doc.user_id.name" class="col">
                    <strong><t t-out="_contact_label"/></strong>
                    <div t-field="doc.user_id">Mitchell Admin</div>
                </div>
            </div>

            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount &gt; 0 for l in lines_to_report)"/>
            <!-- Hide taxes AND show taxed amounts on lines -->
            <t t-set="hide_taxes_details" t-value="False"/>
            <t t-set="display_taxes" t-value="not hide_taxes_details and any(l._has_taxes() for l in lines_to_report)"/>

            <div class="oe_structure"/>
            <table class="o_has_total_table table o_main_table table-borderless">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-start"><t t-out="_desc_label"/></th>
                        <th name="th_quantity" class="text-end text-nowrap"><t t-out="_qty_label"/></th>
                        <th name="th_priceunit" class="text-end text-nowrap"><t t-out="_priceunit_label"/></th>
                        <th name="th_discount" t-if="display_discount" class="text-end">
                            <span><t t-out="_discount_label"/></span>
                        </th>
                        <th name="th_taxes" t-if="display_taxes" class="text-end">
                            <span><t t-out="_taxes_label"/></span>
                        </th>
                        <th name="th_subtotal" class="text-end">
                            <span><t t-out="_amount_label"/></span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_section" t-value="None"/>
                    <t t-set="current_subsection" t-value="None"/>
                    <t t-set="price_field" t-value="'price_total' if hide_taxes_details else 'price_subtotal'"/>

                    <t t-foreach="lines_to_report" t-as="line">

                        <t t-set="is_note" t-value="line.display_type == 'line_note'"/>
                        <t t-set="is_section" t-value="line.display_type == 'line_section'"/>
                        <t t-set="is_subsection" t-value="line.display_type == 'line_subsection'"/>
                        <t t-set="is_combo" t-value="line.product_type == 'combo'"/>

                        <t t-if="is_section">
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subsection" t-value="None"/>
                            <t t-set="line_padding" t-value="1"/>
                            <t t-set="collapse_prices" t-value="line.collapse_prices"/>
                        </t>
                        <t t-elif="is_subsection">
                            <t t-set="current_subsection" t-value="line"/>
                            <t t-set="line_padding" t-value="2"/>
                            <t t-set="collapse_prices" t-value="collapse_prices or line.collapse_prices"/>
                        </t>
                        <t t-else="">
                            <t t-set="line_padding" t-value="3 if current_subsection else (2 if current_section else 0)"/>
                        </t>

                        <t t-if="line.combo_item_id">
                            <t t-set="line_padding" t-value="line_padding + 1"/>
                        </t>

                        <t t-set="padding_style" t-value="line_padding and ('padding-left:' + str(line_padding * 8) + 'px') or ''"/>
                        <t t-set="show_section_total" t-value="is_section or not line.parent_id.collapse_prices"/>

                        <t t-if="not line.collapse_composition">
                            <tr t-if="is_section or is_subsection" name="tr_section" t-attf-class="fw-bold {{'o_line_section' if is_section else 'o_line_subsection'}}">
                                <t t-set="show_section_total" t-value="(                                         (                                             is_section                                             or not line.parent_id.collapse_prices                                         )                                         and not line.is_downpayment                                     )"/>
                                <t t-set="section_name_colspan" t-value="3 + (1 if display_discount else 0) + (1 if display_taxes else 0)"/>
                                <t t-if="not show_section_total">
                                    <t t-set="section_name_colspan" t-value="99"/>
                                </t>
                                <td name="td_section_name" t-att-colspan="section_name_colspan" class="border-end-0" t-att-style="padding_style">
                                    <span t-field="line.name">A section title</span>
                                </td>
                                <td t-if="show_section_total" name="td_section_price" class="text-end o_price_total">
                                    <span t-out="line._get_section_totals(price_field)" class="text-nowrap" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        27.00
                                    </span>
                                </td>
                            </tr>
                            <tr t-elif="is_note" name="tr_note" class="fst-italic o_line_note">
                                <td name="td_note_name" colspan="99" t-att-style="padding_style">
                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </tr>
                            <tr t-elif="is_combo" name="tr_combo" class="o_line_combo fw-bold">
                                <td name="td_combo_name" t-att-style="padding_style">
                                    <span t-field="line.name">Combo Product</span>
                                </td>
                                <td name="td_combo_quantity" class="text-end">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom_id"/>
                                </td>
                                <td name="td_combo_price" t-att-colspan="2 + (1 if display_discount else 0) + (1 if display_taxes else 0)" class="text-end o_price_total">
                                    <span t-if="not collapse_prices" name="price_subtotal_combo" t-out="line._get_combo_totals(price_field)" class="text-nowrap" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        27.00
                                    </span>
                                </td>
                            </tr>
                            <tr t-else="" name="tr_product">
                                <td name="td_product_name" class="w-100" t-att-style="padding_style">
                                    <span t-out="line.product_id.name if line.product_id else line.name"/>
                                </td>
                                <td name="td_product_quantity" class="o_td_quantity text-end">
                                    <span t-out="int(line.product_uom_qty)" class="text-nowrap">3</span>
                                    <span>PAX</span>
                                </td>
                                <td name="td_product_priceunit" class="text-end text-nowrap">
                                    <span t-if="not collapse_prices and line.discount &lt; 0" t-out="(1 - line.discount / 100.0) * line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Price&quot;}"/>
                                    <span t-elif="not collapse_prices" t-field="line.price_unit">
                                        25.00
                                    </span>
                                </td>
                                <td t-if="display_discount" name="td_product_discount" class="text-end">
                                    <t t-if="not collapse_prices">
                                        <!-- ! Always check collapse_prices separately; keep discount condition below for XPath -->
                                        <span t-if="line.discount &gt; 0" t-field="line.discount">-</span>
                                    </t>
                                </td>
                                <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                <td t-if="display_taxes" name="td_product_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 12 else '' }}">
                                    <span t-out="taxes">Tax 15%</span>
                                </td>
                                <td name="td_product_subtotal" class="text-end o_price_total">
                                    <t t-if="not line.is_downpayment and not collapse_prices">
                                        <span t-if="price_field == 'price_subtotal'" t-field="line.price_subtotal">
                                            27.00
                                        </span>
                                        <span t-else="" t-field="line.price_total">
                                            27.00
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <!-- Displaying the section inner content, grouped by taxes -->
                            <tr t-foreach="line._get_grouped_section_summary(display_taxes)" t-as="section_line" name="tr_section_group">
                                <td name="td_section_group_name" t-att-style="padding_style">
                                    <span t-field="line.name">
                                        Section Summary
                                    </span>
                                </td>
                                <td name="td_section_group_quantity" class="text-end text-nowrap">
                                    <span>1.00 Units</span>
                                </td>
                                <td name="td_section_group_priceunit" class="text-end text-nowrap">
                                    <span t-if="show_section_total" name="price_subtotal_section_grouped" t-out="section_line['price_subtotal']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        25.00
                                    </span>
                                </td>
                                <td t-if="display_discount" name="td_section_group_discount">
                                    <!-- NOTE: not computed atm, but at least provides the API for it if needed in the future -->
                                    <t t-set="aggregated_discount" t-value="section_line.get('discount', 0)"/>
                                    <span t-if="aggregated_discount" t-out="aggregated_discount">-</span>
                                </td>
                                <td t-if="display_taxes" name="td_section_group_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(section_line['tax_labels']) &lt; 10 else '' }}">
                                    <span t-out="', '.join(section_line['tax_labels'])">
                                        Tax 15%
                                    </span>
                                </td>
                                <td name="td_section_group_total" class="text-end o_price_total">
                                    <span t-if="show_section_total" t-out="section_line[price_field]" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">
                                        30.00
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div>
                        <table class="o_total_table table table-borderless ms-auto w-auto">
                            <!-- Tax totals -->
                            <t t-call="sale.document_tax_totals" tax_totals="doc.tax_totals" currency="doc.currency_id"/>
                        </table>
                    </div>
                </div>
            </div>
            <div class="oe_structure"/>

            <!-- Page break before service details section -->
            <div style="page-break-before: always; break-before: page;"/>

            <!-- Service details and descriptions (Itineraries) -->
            <div id="product_descriptions" style="margin-top: 30px; page-break-inside: avoid;">
                <t t-set="has_descriptions" t-value="any(not l.display_type and l.product_id and (l.product_id.x_description_sale_html or l.product_id.description_sale) for l in lines_to_report)"/>
                <t t-if="has_descriptions">
                    <div style="margin-bottom: 12px;">
                        <span t-attf-style="display: inline-block; font-size: 12px; font-weight: bold; color: #{doc.company_id.secondary_color or '#E5B745'}; border-bottom: 2px solid #{doc.company_id.secondary_color or '#E5B745'}; padding-bottom: 2px;">
                            <t t-out="_itinerary_title"/>
                        </span>
                    </div>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="not line.display_type and line.product_id and (line.product_id.x_description_sale_html or line.product_id.description_sale)">
                            <div style="margin-bottom: 16px; page-break-inside: avoid;">
                                <div t-attf-style="font-size: 11px; font-weight: bold; color: #{doc.company_id.primary_color or '#20603D'}; margin-bottom: 4px;">
                                    <span t-field="line.product_id.name"/>
                                </div>
                                <div style="font-size: 10px; color: #4b5563; line-height: 1.45; padding-left: 8px; border-left: 1px solid #e5e7eb;">
                                    <t t-if="line.product_id.x_description_sale_html">
                                        <t t-out="line.product_id.x_description_sale_html"/>
                                    </t>
                                    <t t-else="">
                                        <div style="white-space: pre-line;">
                                            <span t-field="line.product_id.description_sale"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </div>

            <div t-if="not doc.signature or not doc.env.context.get('sale_include_signature')" class="oe_structure"/>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong><t t-out="_signature_label"/></strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>
            <div>
                <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                <p t-if="not is_html_empty(doc.payment_term_id.note)">
                    <span t-field="doc.payment_term_id.note">The payment should also be transmitted with love</span>
                </p>
                <div class="oe_structure"/>
                <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                    <strong><t t-out="_fiscal_remark_label"/></strong>
                    <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                </p>
            </div>
            <div class="oe_structure"/>
            <t t-set="base_address" t-value="doc.env['ir.config_parameter'].sudo().get_str('web.base.url')"/>
            <t t-set="portal_url" t-value="base_address + '/my/orders/' + str(doc.id) + '#portal_connect_software_modal_btn'"/>
            <div t-if="any(u._is_portal() for u in doc.partner_id.user_ids) and doc._get_edi_builders()" class="text-center">
                <a t-att-href="portal_url"><t t-out="_connect_label"/></a> <t t-out="_with_label"/> <t t-out="doc.company_id.name"/> <t t-out="_auto_quotes_label"/>
            </div>
        </div>
    </t>
</t>