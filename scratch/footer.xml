<?xml version="1.0"?>
<t t-name="web.external_layout_footer_content">
    <div t-attf-class="o_footer_content {{footer_content_classes}}" style="position: relative; background-color: #FFFFFF; font-family: 'Helvetica', 'Arial', sans-serif; width: 100%; border-top: none !important; margin-top: 20px;">
        
        <!-- Franja Montañosa (SVG) -->
        <svg style="position: absolute; top: -35px; left: 0; width: 100%; height: 35px;" preserveAspectRatio="none" viewBox="0 0 1000 100">
            <!-- Linea inferior Mostaza -->
            <path d="M0,80 Q250,70 500,50 T900,10 L1000,90 L0,90 Z" fill="#C79F27"/>
            <!-- Linea superior Verde Bosque -->
            <path d="M0,70 Q250,60 500,40 T900,0 L1000,80 L1000,100 L0,100 Z" fill="#1D5D3A"/>
            <!-- Base blanca -->
            <rect x="0" y="85" width="1000" height="20" fill="#FFFFFF" />
        </svg>

        <div style="display: table; width: 100%; padding-top: 15px; padding-bottom: 10px;">
            <!-- Izquierda: Web -->
            <div style="display: table-cell; vertical-align: middle; text-align: left; width: 35%;">
                <span style="color: #595959; font-size: 13px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#595959" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom; margin-right: 5px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                    www.waykitrek.net
                </span>
            </div>

            <!-- Derecha: ISOs, Divisor y Logo -->
            <div style="display: table-cell; vertical-align: middle; text-align: right; width: 65%; white-space: nowrap;">
                
                <!-- Certificaciones ISO -->
                <div style="display: inline-block; vertical-align: middle; margin-right: 15px; color: #1D5D3A; text-align: center;">
                    <t t-set="iso_svg">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1D5D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 2px;">
                            <path d="M12 2 L2 12 h3 v8 h14 v-8 h3 Z"/>
                            <path d="M12 2 v20"/>
                            <path d="M5 12 h14"/>
                            <path d="M8 8 h8"/>
                        </svg>
                    </t>
                    
                    <div style="display: inline-block; margin: 0 5px; text-align: center;">
                        <t t-out="iso_svg"/><br/>
                        <span style="font-size: 9px; font-weight: bold;">ISO 9001</span>
                    </div>
                    <div style="display: inline-block; margin: 0 5px; text-align: center;">
                        <t t-out="iso_svg"/><br/>
                        <span style="font-size: 9px; font-weight: bold;">ISO 14001</span>
                    </div>
                    <div style="display: inline-block; margin: 0 5px; text-align: center;">
                        <t t-out="iso_svg"/><br/>
                        <span style="font-size: 9px; font-weight: bold;">ISO 45001</span>
                    </div>
                </div>

                <!-- Línea Divisoria -->
                <div style="display: inline-block; vertical-align: middle; width: 1px; height: 40px; background-color: #595959; margin-right: 15px;"></div>

                <!-- Logotipo Wayki Trek -->
                <div style="display: inline-block; vertical-align: middle; text-align: center;">
                    <svg width="35" height="35" viewBox="0 0 100 100" style="margin-bottom: 2px;">
                        <!-- Triángulo Superior Verde -->
                        <polygon points="50,10 15,55 85,55" fill="#1D5D3A"/>
                        <!-- Recorte Rostro (Espacio negativo blanco) -->
                        <path d="M15,55 L35,55 L45,40 L40,30 L48,20 L50,10 Z" fill="#FFFFFF"/>
                        <!-- Bloques Amarillos Inferiores -->
                        <polygon points="15,60 48,60 48,90" fill="#C79F27"/>
                        <polygon points="52,60 85,60 52,90" fill="#C79F27"/>
                    </svg><br/>
                    <div style="color: #1D5D3A; font-size: 14px; font-weight: 900; letter-spacing: 0.5px; margin-top: -4px;">WAYKI TREK</div>
                </div>
            </div>
        </div>
    </div>
</t>
